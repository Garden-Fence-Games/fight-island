root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Godot's official GDScript style uses tabs.
[*.gd]
indent_style = tab
indent_size = 4

[*.{tscn,tres,godot,import,cfg}]
indent_style = tab

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
