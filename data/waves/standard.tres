[gd_resource type="Resource" script_class="WaveConfig" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/resources/wave_config.gd" id="1"]
[ext_resource type="Script" path="res://scripts/resources/wave_band.gd" id="2"]
[ext_resource type="Script" path="res://scripts/resources/archetype_share.gd" id="3"]
[ext_resource type="Resource" path="res://data/enemies/farmhand.tres" id="4"]
[ext_resource type="Resource" path="res://data/enemies/pirate.tres" id="10"]
[ext_resource type="Resource" path="res://data/day/turn.tres" id="7"]
[ext_resource type="Resource" path="res://data/waves/elite.tres" id="8"]

[sub_resource type="Resource" id="Farmhand_1"]
script = ExtResource("3")
enemy = ExtResource("4")
share = 1.00

[sub_resource type="Resource" id="Band_1"]
script = ExtResource("2")
first_wave = 1
shares = Array[ExtResource("3")]([SubResource("Farmhand_1")])

[sub_resource type="Resource" id="Farmhand_4"]
script = ExtResource("3")
enemy = ExtResource("4")
share = 0.90

[sub_resource type="Resource" id="Pirate_4"]
script = ExtResource("3")
enemy = ExtResource("10")
share = 0.10

[sub_resource type="Resource" id="Band_4"]
script = ExtResource("2")
first_wave = 4
shares = Array[ExtResource("3")]([SubResource("Farmhand_4"), SubResource("Pirate_4")])

[resource]
script = ExtResource("1")
bands = Array[ExtResource("2")]([SubResource("Band_1"), SubResource("Band_4")])
cycle = ExtResource("7")
elite = ExtResource("8")
