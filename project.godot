[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player_body"
3d_physics/layer_3="enemy_body"
3d_physics/layer_4="player_hitbox"
3d_physics/layer_5="enemy_hitbox"
3d_physics/layer_6="player_hurtbox"
3d_physics/layer_7="enemy_hurtbox"
3d_physics/layer_8="interactable"
3d_physics/layer_9="camera_occluder"
3d_physics/layer_10="spawn_blocker"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
